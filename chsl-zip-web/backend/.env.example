# ============================================================
# CHSL ZIP Web App — backend configuration
# Copy to backend/.env and adjust if needed. Defaults work as-is.
# ============================================================

# Port + bind address
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------
# DATA SOURCE (verified from the original APK)
# Home3 builds: CONTENT_BASE + one of the JSON paths
# (b_data.json, handwritten.json, mcq.json, questionbank.json,
#  revision.json, c_data.json)
# If the app's server ever moves, update CONTENT_BASE +
# ALLOWED_HOSTS below — everything else adapts automatically.
# ------------------------------------------------------------
CONTENT_BASE=https://bollywoodnewstoday.com/appdata/com.tarun.sscchslpreviousyearpapers
ALLOWED_HOSTS=bollywoodnewstoday.com,www.bollywoodnewstoday.com
ALLOWED_PATH_PREFIX=/appdata/

# How long the content JSON cache is valid (ms). New years/categories
# appear on the site automatically after this.
CONTENT_TTL_MS=300000

# Download hardening
CONCURRENCY=5
MAX_FILE_MB=150
MAX_FILES=1500
FILE_TIMEOUT_MS=180000

# Job management
MAX_RUNNING_JOBS=2
JOB_CREATE_RATE_PER_MIN=20

# Finished ZIPs auto-delete from the server after this many minutes
ZIP_TTL_MIN=180
